{
  "name": "pact",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.ts packages/engine/src/*.test.ts packages/core/src/*.test.ts workers/api/src/*.test.ts",
    "prepare": "sh scripts/install-git-hooks.sh",
    "mcp": "node mcp/server.mjs",
    "export": "node scripts/static-export.mjs",
    "build:pages": "PACT_BASE_PATH=/pact node scripts/static-export.mjs",
    "build:apk": "node scripts/static-export.mjs && npx cap sync android",
    "apk": "npm run build:apk && npm run apk:assemble",
    "apk:assemble": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
