/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(self), geolocation=(self), bluetooth=(self), microphone=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; connect-src 'self' https://pact-api.ajeenckya.workers.dev wss://pact-api.ajeenckya.workers.dev https://world.openfoodfacts.org https://api.open-meteo.com https://air-quality-api.open-meteo.com https://geocoding-api.open-meteo.com https://api.bigdatacloud.net https://www.themealdb.com https://www.strava.com https://nominatim.openstreetmap.org https://overpass-api.de; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
